SECRET_KEY=change-me-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL 8+
DB_NAME=ahp_engenharia
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Exclusivamente para testes locais sem MySQL. Não utilizar em produção.
USE_SQLITE=False

# Email (console em desenvolvimento)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responder@localhost

# Segurança de sessão (True em produção com HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
